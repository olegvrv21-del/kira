# ===========================================================================
# Kira — configuration
# Copy this file to `.env` and fill in your values.
# ===========================================================================

# --- LLM provider (Kiro Q) -------------------------------------------------
# Get your key at https://kiro.dev/
KIRO_API_KEY=ksk_REPLACE_ME
# Optional: comma-separated pool of keys for failover / quota expansion
# KIRO_API_KEYS=ksk_xxx,ksk_yyy
# Custom Q endpoint (default: https://q.us-east-1.amazonaws.com)
# KIRO_Q_URL=
#
# Provider selection: amazon-q (default) | openrouter | fallback | mock
# KIRA_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # or an OpenAI-compatible gateway
#
# --- Resilient fallback chain (KIRA_LLM_PROVIDER=fallback) -----------------
# Ordered list of "<provider>:<model>" targets. On balance-exhaustion (HTTP
# 402 / "insufficient credit"), auth failure, or transient 429/5xx, Kira
# retries then fails over to the next target instead of going silent. When
# every target on the chain is balance-banned, /agent/health flips to
# "critical" and the existing health_alert.sh fires a Telegram alert.
# KIRA_LLM_CHAIN=openrouter:gpt-5.4-mini, openrouter:gpt-5.6, openrouter:glm-5.2
# KIRA_LLM_FALLBACK_RETRIES=2          # transient retries per target
# KIRA_LLM_FALLBACK_BACKOFF=1.5        # base backoff seconds (exponential)
# KIRA_LLM_FALLBACK_BAN_SECONDS=900    # how long a failed target is skipped

# --- Auth ------------------------------------------------------------------
# Bearer token clients must send. Generate one:  openssl rand -base64 24
KIRA_AUTH_TOKEN=ktk_REPLACE_ME
# Set to "1" to allow unauthenticated access (NOT recommended)
KIRA_AUTH_ALLOW_PUBLIC=0

# --- Rate limiting ---------------------------------------------------------
KIRA_RATE_LIMIT=60          # requests per window per IP
KIRA_RATE_WINDOW=60         # window seconds

# --- Cost caps -------------------------------------------------------------
KIRA_SESSION_LIMIT=5        # max LLM calls per session
KIRA_DAILY_LIMIT=30         # max LLM calls per day
KIRA_MONTHLY_LIMIT=800      # max LLM calls per month
KIRA_SESSION_TTL_DAYS=30    # session retention

# --- Sandbox ---------------------------------------------------------------
# 1 = each session runs in its own Docker container (recommended, requires Docker-in-Docker setup)
# 0 = tools run on host (simpler; this app container only)
KIRA_SANDBOX=0
KIRA_SANDBOX_IMAGE=kira-sandbox:latest
KIRA_SANDBOX_MEM=512m
KIRA_SANDBOX_CPUS=1
KIRA_SANDBOX_NETWORK=bridge

# --- Self-modify -----------------------------------------------------------
# Allow Kira to edit her own source code (only meaningful with sandbox=1)
KIRA_SELF_EDIT=0

# --- Critic ----------------------------------------------------------------
KIRA_CRITIC_AUTO=1
KIRA_CRITIC_MAX_DIFF=8000
# KIRA_CRITIC_MODEL=anthropic.claude-haiku-4-5-20251001-v1:0
# KIRA_CRITIC_PROVIDER=openrouter   # de-correlate from main LLM (P1 in HANDOFF)
# KIRA_CRITIC_MODEL=openai/gpt-4o-mini  # cheap second-opinion when on OpenRouter

# --- Memory / embeddings ---------------------------------------------------
KIRA_MEMORY_EMBED=0         # 1 = use embeddings for semantic memory
# KIRA_EMBED_MODEL=amazon.titan-embed-text-v2:0
# KIRA_EMBED_BLEND=0.5

# --- Port (host side) ------------------------------------------------------
KIRA_PORT=3000
